[
  {
    "description": "Claim a handoff as the agent it is addressed to. The state is checked against its recorded sha256, then exactly one claim wins: the winner gets claimed=true and the state; every other claimant gets claimed=false and the winner's name. A handoff for another agent, an unknown one and one whose state no longer matches its hash are errors, and none of them claims it.",
    "input": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "description": "an agent's name: a-z, 0-9, - and _",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "type": "string"
        },
        "handoff_id": {
          "description": "the handoff_id that handoff returned",
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "principal": {
          "description": "whose memory graph: a-z, 0-9, - and _",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "handoff_id",
        "agent"
      ],
      "type": "object"
    },
    "name": "claim",
    "read_only": false
  },
  {
    "description": "Hand a task from one agent to another through a principal's memory graph that both use. The JSON state is stored exactly as given, with its sha256. Pass the returned handoff_id to the target, which calls claim.",
    "input": {
      "additionalProperties": false,
      "properties": {
        "principal": {
          "description": "whose memory graph: a-z, 0-9, - and _",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "type": "string"
        },
        "source": {
          "description": "an agent's name: a-z, 0-9, - and _",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "type": "string"
        },
        "state": {
          "additionalProperties": true,
          "type": "object"
        },
        "target": {
          "description": "an agent's name: a-z, 0-9, - and _",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "source",
        "target",
        "state"
      ],
      "type": "object"
    },
    "name": "handoff",
    "read_only": false
  },
  {
    "description": "Consolidate a principal's episodes and return everything it has learned. A subject is learned only from two or more episodes that agree on the value and none that disagree; each learned fact comes with the evidence of the agreeing episodes and can be read back with recall under its key.",
    "input": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "principal": {
          "description": "whose memory graph: a-z, 0-9, - and _",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "principal"
      ],
      "type": "object"
    },
    "name": "learned",
    "read_only": false
  },
  {
    "description": "Read a fact from a principal's memory with its version (found=false, version 0 when absent).",
    "input": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "a fact's name",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "principal": {
          "description": "whose memory graph: a-z, 0-9, - and _",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "key"
      ],
      "type": "object"
    },
    "name": "recall",
    "read_only": true
  },
  {
    "description": "Record what happened on one task: a subject, the value found and the ids of the evidence for it. Episodes are never changed or removed; learned consolidates them.",
    "input": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "description": "ids that support the value: artifact ids, proof hashes",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "principal": {
          "description": "whose memory graph: a-z, 0-9, - and _",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "type": "string"
        },
        "subject": {
          "description": "what the episode is about; episodes agree only on exact text",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "task": {
          "description": "the task this episode came from",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "type": "string"
        }
      },
      "required": [
        "principal",
        "task",
        "subject",
        "value",
        "evidence"
      ],
      "type": "object"
    },
    "name": "record_episode",
    "read_only": false
  },
  {
    "description": "Write a fact into a principal's memory by compare-and-set. expected_version 0 creates the fact; otherwise it must be the version last read. A stale version never overwrites: the result says ok=false with the current version and value, so the caller can merge and retry. Names starting 'sem:' belong to consolidation.",
    "input": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "description": "0 creates; otherwise the version last read",
          "maximum": 1000000000,
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "description": "a fact's name",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "principal": {
          "description": "whose memory graph: a-z, 0-9, - and _",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "type": "string"
        }
      },
      "required": [
        "principal",
        "key",
        "value",
        "expected_version"
      ],
      "type": "object"
    },
    "name": "remember",
    "read_only": false
  }
]
